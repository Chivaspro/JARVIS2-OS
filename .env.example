# ─────────────────────────────────────────────────────────────────────────────
# Mark LII — environment configuration (PLACEHOLDERS ONLY)
#
# Copy to `.env` and fill in what you use. Real secrets normally live in
# config/api_keys.json (gitignored). Anything left empty falls back to the
# local/default behavior. NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core model (optional here; config/api_keys.json remains the primary store) ──
GEMINI_API_KEY=your-gemini-api-key-here

# ── Long-term memory backend (features.mem0_memory=true) ──
MEM0_API_KEY=your-mem0-api-key-here
MEM0_USER_ID=default

# ── Knowledge corpus (features.qdrant_knowledge=true) ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ── Observability (features.langfuse_tracing=true) ──
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Computer control backend: auto (detect) | on | off ──
CUA_BACKEND=auto

# ── Coding agents ──
OPENHANDS_MODE=docker            # docker | remote
OPENHANDS_REMOTE_URL=            # when OPENHANDS_MODE=remote
AIDER_BIN=aider                  # aider executable on PATH

# ── Runtime ──
JARVIS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
JARVIS_DATA_DIR=data             # logs/cache/runtime root (relative to repo)
